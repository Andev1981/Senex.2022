{
  "compilerOptions": {
    /* Entorno y Módulos */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Compatibilidad con JS (CRUCIAL PARA TI) */
    "allowJs": true, /* Permite archivos JS */
    "checkJs": false, /* NO reportes errores en archivos JS */
    /* Relajando la rigurosidad */
    "strict": false, /* Desactiva modo estricto */
    "noImplicitAny": false, /* Permite variables sin tipo */
    "skipLibCheck": true, /* Ignora errores en librerías de node_modules */
    /* Interop */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    /* Rutas */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./resources/js/*"
      ],
      "ziggy-js": [
        "./vendor/tightenco/ziggy"
      ]
    }
  },
  "include": [
    "resources/js/**/*.js", /* AGREGADO */
    "resources/js/**/*.jsx", /* AGREGADO */
    "resources/js/**/*.ts",
    "resources/js/**/*.tsx",
    "resources/js/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "vendor"
  ]
}