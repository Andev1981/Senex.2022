                </table>
            </div>
            <div className="bg-gray-50/30 border-t border-gray-100">
                <TablePagination table={table} total={plans.length} pageSize={pageSize} setPageSize={setPageSize} pagesizeOptions={[5, 10, 20]} />
            </div>
        </div>
      </div>
    </div>
  );
}
