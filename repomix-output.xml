                              className="h-full transition-all bg-brand-primary rounded-full shadow-[0_0_8px_rgba(var(--brand-primary-rgb),0.4)]"
                              style={{
                                width: `${treatment.progress.percentage}%`,
                              }}
                            />
                          </div>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
        </div>

        {/* Columna Derecha: Sesiones Recientes */}
        <div className="lg:col-span-8">
            <div className="p-6 bg-white rounded-[2rem] border border-slate-100 shadow-sm h-full">
              <h2 className="mb-6 text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                <History className="w-4 h-4 text-brand-primary" /> Historial de Atenciones
              </h2>
              {patient.recent_sessions.length === 0 ? (
                <div className="py-20 flex flex-col items-center justify-center text-center">
                    <FileText className="w-12 h-12 text-slate-100 mb-4" />
                    <p className="text-slate-400 font-bold text-xs uppercase tracking-widest">Sin sesiones registradas</p>
                </div>
              ) : (
                <div className={`grid grid-cols-1 ${isDesktop ? 'md:grid-cols-2' : ''} gap-4`}>
                  {patient.recent_sessions.map((session) => (
                    <div
                      key={session.id}
                      className="flex items-center gap-4 p-4 border border-slate-50 bg-slate-50/50 rounded-2xl hover:border-brand-primary/20 hover:bg-white transition-all cursor-pointer group shadow-sm"
                      onClick={() => router.visit(route('kine.sessions.show', session.id))}
                    >
                      <div className="w-12 h-12 rounded-xl bg-white flex shrink-0 items-center justify-center shadow-sm text-brand-primary group-hover:bg-brand-primary group-hover:text-white transition-colors">
                          <Calendar className="w-5 h-5" />
                      </div>
                      
                      <div className="flex-1 min-w-0">
                        <div className="flex items-start justify-between mb-1">
                            <p className="text-xs font-black text-slate-900 uppercase truncate pr-2">
                            {session.session_type}
                            </p>
                            <span
                                className={`shrink-0 px-2 py-0.5 text-[8px] font-black uppercase rounded-md border ${
                                session.status === "Completada"
                                    ? "bg-green-50 text-green-700 border-green-100"
                                    : "bg-blue-50 text-blue-600 border-blue-100"
                                }`}
                            >
                                {session.status}
                            </span>
                        </div>
                        <p className="text-[10px] font-bold text-slate-500 uppercase tracking-tighter">
                          {moment(session.date).format("DD/MM/YYYY")} • {session.time}
                        </p>
                        {session.notes && (
                          <div className="mt-2 p-2.5 bg-white/60 rounded-lg border border-slate-100">
                             <p className="text-[9px] text-slate-600 font-bold italic line-clamp-2 leading-relaxed">
                                {session.notes}
                            </p>
                          </div>
                        )}
                      </div>
                      
                      <div className="shrink-0 flex items-center justify-center text-slate-300 group-hover:text-brand-primary transition-colors">
                          <ChevronRight className="w-5 h-5" />
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
        </div>
      </div>
    </div>
  );

  return isDesktop ? (
    <AuthenticatedLayout>{Content}</AuthenticatedLayout>
  ) : (
    <KineLayout>{Content}</KineLayout>
  );
}

// Icono faltante en importaciones previas pero usado aquí
function History(props) {
  return (
    <svg
      {...props}
      xmlns="http://www.w3.org/2000/svg"
