                                            value={data.tutor_phone} 
                                            onChange={v => setData("tutor_phone", v)} 
                                            required={data.require_tutor}
                                        />
                                        <InputError message={localErrors.tutor_phone} />
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>

                    {/* Footer */}
                    <div className="p-8 bg-gray-50 border-t border-gray-100 flex gap-4 shrink-0">
                        <button 
                            type="submit" 
