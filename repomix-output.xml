import { useForm } from "@inertiajs/react";
import React from "react";

function ModalDeleteInsurance({ insurance, setOpenModalDelete }) {
  const {
    data,
    reset,
    processing,
    delete: destroy,
  } = useForm({
    id: insurance?.id ? insurance?.id : null,
  });

  const handleDelete = (e) => {
    e.preventDefault();

    if (data?.id !== null) {
      destroy(route("insurances.destroy", data.id), {
        onSuccess: () => {
          setOpenModalDelete(false);
          reset();
        },
      });
    }
  };

  return (
    <div className="px-4">
      <h2 className="mb-2 text-xl font-bold text-center text-gray-600 dark:text-gray-100">
        Delete this insurance company?
