                        : "text-gray-400 bg-gray-300 cursor-not-allowed"
                    } ${processing ? "opacity-70" : ""}`}
                  >
                    {processing ? "Emitiendo..." : "Emitir Documento"}
                  </button>
                  <button
                    type="button"
