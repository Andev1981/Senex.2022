                                    <ROMGauge label="Abducción" value={formData.rom_abduction_before} onChange={(val) => setFormData({...formData, rom_abduction_before: val})} icon={MoveDiagonal} />
                                    <ROMGauge label="Rotación" value={formData.rom_rotation_before} onChange={(val) => setFormData({...formData, rom_rotation_before: val})} icon={RotateCcw} />
                                </div>
                                <textarea 
                                    value={formData.objective} 
