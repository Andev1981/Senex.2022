/* === Loader styles === */
@keyframes heartbeatSlow {

  0%,
  100% {
    transform: scale(1);
    filter: hue-rotate(0deg);
  }

  25% {
    transform: scale(1.05);
    filter: hue-rotate(10deg);
  }

  50% {
    transform: scale(0.995);
    filter: hue-rotate(5deg);
  }

  75% {
    transform: scale(1.04);
    filter: hue-rotate(15deg);
  }
}

.heartbeat-slow {
  animation: heartbeatSlow 2.6s ease-in-out infinite;
  transform-origin: center;
  filter: drop-shadow(0 0 0.25rem rgba(20, 184, 166, 0.25));
}

@keyframes shimmer {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 100% 50%;
  }
}

.thinking-text {
  display: inline-flex;
  align-items: baseline;
  gap: 4px;
  background-image: linear-gradient(90deg, #0ea5e9, #14b8a6, #8b5cf6);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: shimmer 3.6s linear infinite;
  white-space: nowrap;
}

@keyframes dotPulse {

  0%,
  20% {
    opacity: 0.25;
    transform: translateY(0);
  }

  40% {
    opacity: 1;
    transform: translateY(-2px);
  }

  60%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }
}

.thinking-text .dots {
  display: inline-flex;
  gap: 2px;
  margin-left: 2px;
  letter-spacing: 2px;
  background: none;
  /* evita heredar el background-clip */
  color: #0f766e;
  /* o usa currentColor si quieres que herede el color */
}

.thinking-text .dots span {
  display: inline-block;
  animation: dotPulse 1.5s ease-in-out infinite;
}

.thinking-text .dots span:nth-child(2) {
  animation-delay: 0.2s;
}

.thinking-text .dots span:nth-child(3) {
  animation-delay: 0.4s;
}

/* Accesibilidad */
@media (prefers-reduced-motion: reduce) {

