                                        <textarea value={formData.assessment} onChange={(e) => setFormData({...formData, assessment: e.target.value})} rows={6} className="w-full bg-slate-50 border-none rounded-3xl p-6 text-sm font-medium shadow-inner focus:bg-white focus:ring-teal-500/5 transition-all" placeholder="Juicio profesional..."/>
