namespace App\Http\Controllers\KineMobile;

use App\Http\Controllers\Controller;
use App\Models\Appointment;
use App\Models\Availability;
use Carbon\Carbon;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Inertia\Inertia;

class ScheduleMobileController extends Controller
{
    public function index()
    {
        $doctor = Auth::user()->doctor;
        if (!$doctor) {
            return redirect()->route('dashboard');
        }

        // Obtener horarios base de disponibilidad
        $availabilities = Availability::where('doctor_id', $doctor->id)
            ->where('is_active', true)
            ->orderBy('start_time')
            ->get();

        // Obtener citas programadas para los proximos 7 dias (excluyendo hoy)
        $upcomingAppointments = Appointment::with(['patient', 'item'])
            ->where('doctor_id', $doctor->id)
            ->where('start_at', '>=', now()->addDay()->startOfDay())
            ->where('start_at', '<=', now()->addDay()->startOfDay()->addDays(7))
            ->orderBy('start_at')
            ->get();

        return Inertia::render('kine-mobile/my-schedule', [
            'availabilities' => $availabilities,
            'upcomingAppointments' => $upcomingAppointments->map(fn($apt) => [
                'id' => $apt->id,
                'patient_name' => $apt->patient?->full_name,
                'start_at' => $apt->start_at->toIso8601String(),
                'end_at' => $apt->end_at->toIso8601String(),
                'item_name' => $apt->item?->name,
                'status' => $apt->status,
            ]),
        ]);
    }
}
