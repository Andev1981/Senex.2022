                        <span className="text-[10px] font-bold text-gray-400">
                          {new Date(doc.created_at).toLocaleDateString("es-CL")}
                        </span>
                      </div>
                    </div>
                  </div>

                  <div className="mt-6 pt-4 border-t border-gray-50 flex gap-2 relative z-10">
