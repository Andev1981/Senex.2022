            {/* Card de deudas */}
            <div className="overflow-hidden bg-white shadow-lg rounded-2xl">
              {/* Seleccionar todos */}
              {deudas.length > 1 && (
                <div className="px-5 py-4 border-b border-gray-100">
                  <label className="flex items-center cursor-pointer">
                    <input
