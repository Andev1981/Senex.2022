        </div>
      )}

      {/* APP HEADER - Estilo Soft & Pro */}
      <header className="sticky top-0 z-[60] bg-brand-primary/30 backdrop-blur-xl border-b border-brand-primary/10 px-4 py-3 flex items-center justify-between">
