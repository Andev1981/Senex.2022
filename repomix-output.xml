                      <div className="flex items-start justify-between mb-3">
                        <div className="min-w-0">
                          <p className="text-xs font-black text-slate-900 uppercase truncate">
                            {treatment.session_type}
                          </p>
                          <p className="text-[10px] font-bold text-slate-500 uppercase tracking-tighter mt-1 truncate">
                            {treatment.diagnosis}
                          </p>
                        </div>
                        <span
                          className={`px-2 py-0.5 text-[8px] font-black uppercase rounded-lg border ${
                            treatment.status === "InProgress"
                              ? "bg-blue-50 text-blue-600 border-blue-100"
                              : "bg-slate-50 text-slate-500 border-slate-100"
                          }`}
                        >
                          {treatment.status}
                        </span>
                      </div>

                      {treatment.progress.total > 0 && (
                        <div className="mt-4">
                          <div className="flex items-center justify-between mb-2 text-[9px] font-black uppercase text-slate-400">
                            <span>Progreso</span>
                            <span>
                              {treatment.progress.completed}/
                              {treatment.progress.total}
                            </span>
                          </div>
                          <div className="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
