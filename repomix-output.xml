                {/* Indicador de Punto Activo */}
                {item.active && (
                    <span className="absolute -bottom-1 w-1 h-1 bg-brand-primary rounded-full shadow-[0_0_8px_rgba(var(--brand-primary-rgb),0.6)] animate-pulse" />
