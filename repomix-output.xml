                    stroke="currentColor"
                    strokeWidth="2"
                    strokeLinecap="round"
                  />
                  <circle cx="20" cy="20" r="3" fill="currentColor" />
                </svg>
                <span className="text-xl font-semibold">KineMobile</span>
              </div>
            </div>
          </header>

          <main className="max-w-lg px-4 py-8 mx-auto">
            <div className="pt-12">
              <div className="p-12 text-center bg-white shadow-lg rounded-2xl">
                <div className="mb-6">
                  <svg
                    className="w-20 h-20 mx-auto text-green-500"
                    fill="none"
                    viewBox="0 0 80 80"
                  >
                    <circle
                      cx="40"
                      cy="40"
                      r="38"
                      stroke="currentColor"
                      strokeWidth="3"
                    />
                    <path
                      d="M24 40L35 51L56 30"
                      stroke="currentColor"
                      strokeWidth="4"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                    />
                  </svg>
                </div>
                <h1 className="mb-3 text-2xl font-semibold text-green-500">
                  ¡Todo al día!
                </h1>
                <p className="mb-8 text-lg text-gray-600">
