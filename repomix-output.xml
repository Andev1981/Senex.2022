// resources/js/pages/KineMobile/PatientDetail.jsx
import React from "react";
import { Head, router } from "@inertiajs/react";
import moment from "moment";
import "moment/dist/locale/es";
import {
  ArrowLeft,
  Phone,
  Mail,
  Calendar,
  User,
  Activity,
  FileText,
  TrendingUp,
  ChevronLeft,
  ChevronRight,
  Zap,
  Bone,
  Baby,
  AlertCircle,
  ShieldAlert,
  Stethoscope
} from "lucide-react";
import KineLayout from "@/Layouts/KineLayout";
import AuthenticatedLayout from "@/Layouts/AuthenticatedLayout";
import { useMediaQuery } from "@/hooks/useMediaQuery";

export default function PatientDetail({ patient }) {
  const isDesktop = useMediaQuery("(min-width: 1024px)");

  const handleBack = () => {
    router.visit(route("kine.my-patients"));
  };

  const handleCallPatient = () => {
    if (patient.phone) {
      window.location.href = `tel:${patient.phone}`;
    }
  };

  const Content = (
    <div className={`min-h-screen ${isDesktop ? 'p-8' : 'pb-20'} bg-gray-50/50`}>
      <Head title={patient.name} />

      {/* Header Responsivo */}
      <div className={`${isDesktop ? 'mb-8 bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm' : 'sticky top-0 z-10 bg-white border-b border-gray-200 shadow-sm'}`}>
        <div className={isDesktop ? '' : 'px-4 py-4'}>
          <div className="flex items-center gap-6">
            <button
              onClick={handleBack}
              className="p-3 text-gray-600 transition-all rounded-2xl bg-slate-50 hover:bg-slate-100 active:scale-95"
            >
              {isDesktop ? <ArrowLeft className="w-6 h-6" /> : <ChevronLeft className="w-5 h-5" />}
            </button>
            <div className="flex-1">
              <h1 className={`${isDesktop ? 'text-3xl' : 'text-lg'} font-black text-slate-900 tracking-tight leading-none uppercase`}>
                {patient.name}
              </h1>
              <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">{patient.rut}</p>
            </div>
            {patient.phone && (
              <button
                onClick={handleCallPatient}
                className={`${isDesktop ? 'px-6 py-3 flex items-center gap-3' : 'p-3'} text-white bg-teal-600 rounded-2xl shadow-lg hover:bg-teal-700 active:scale-95 transition-all`}
              >
                <Phone className="w-5 h-5" />
                {isDesktop && <span className="text-[10px] font-black uppercase tracking-widest">Llamar ahora</span>}
              </button>
            )}
          </div>
        </div>
      </div>

      {/* Grid de Información */}
      <div className={`lg:grid lg:grid-cols-12 lg:gap-8 ${isDesktop ? '' : 'px-4 py-4 space-y-4'}`}>
        
        {/* Columna Izquierda: Datos y Tratamientos */}
        <div className="lg:col-span-4 space-y-6">
            {/* Datos personales */}
            <div className="p-6 bg-white rounded-[2rem] border border-slate-100 shadow-sm">
              <h2 className="mb-6 text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                <User className="w-4 h-4 text-brand-primary" /> Datos del Paciente
              </h2>
              <div className="space-y-4">
                {patient.phone && (
                  <div className="flex items-center gap-3">
                    <div className="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center">
                        <Phone className="w-4 h-4 text-slate-400" />
                    </div>
                    <span className="text-xs font-bold text-slate-600">{patient.phone}</span>
                  </div>
                )}
                {patient.email && (
                  <div className="flex items-center gap-3">
                    <div className="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center">
                        <Mail className="w-4 h-4 text-slate-400" />
                    </div>
                    <span className="text-xs font-bold text-slate-600">{patient.email}</span>
                  </div>
                )}
                {patient.birth_date && (
                  <div className="flex items-center gap-3">
                    <div className="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center">
                        <Calendar className="w-4 h-4 text-slate-400" />
                    </div>
                    <span className="text-xs font-bold text-slate-600">
                      {moment(patient.birth_date).format("DD/MM/YYYY")}
                    </span>
                  </div>
                )}
              </div>

              {patient.emergency_contact && (
                <div className="pt-6 mt-6 border-t border-slate-50">
                  <p className="mb-3 text-[9px] font-black text-slate-400 uppercase tracking-widest">
                    Contacto de emergencia
                  </p>
                  <p className="text-sm font-black text-slate-900 uppercase">
                    {patient.emergency_contact.name}
                  </p>
                  <p className="text-xs font-bold text-slate-500 mt-1">
                    {patient.emergency_contact.phone}
                  </p>
                </div>
              )}
            </div>

            {/* Antecedentes Clínicos y Alertas */}
            <div className="p-6 bg-white rounded-[2rem] border border-slate-100 shadow-sm">
                <h2 className="mb-6 text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                    <Stethoscope className="w-4 h-4 text-red-500" /> Antecedentes & Alertas
                </h2>

                {/* BANDERAS ROJAS (Alertas Críticas) */}
                {(patient.medical_history?.has_pacemaker || 
                  patient.medical_history?.has_metal_implants || 
                  patient.medical_history?.is_pregnant || 
                  patient.medical_history?.cancer_history) ? (
                    <div className="mb-6 grid grid-cols-2 gap-3">
                        {patient.medical_history?.has_pacemaker && (
                            <div className="p-3 bg-red-50 border border-red-100 rounded-2xl flex flex-col items-center text-center gap-1 animate-pulse">
                                <Zap className="w-4 h-4 text-red-600" />
                                <span className="text-[8px] font-black text-red-700 uppercase">Marcapasos</span>
                            </div>
                        )}
                        {patient.medical_history?.has_metal_implants && (
                            <div className="p-3 bg-orange-50 border border-orange-100 rounded-2xl flex flex-col items-center text-center gap-1">
                                <Bone className="w-4 h-4 text-orange-600" />
                                <span className="text-[8px] font-black text-orange-700 uppercase">Implantes</span>
                            </div>
                        )}
                        {patient.medical_history?.is_pregnant && (
                            <div className="p-3 bg-purple-50 border border-purple-100 rounded-2xl flex flex-col items-center text-center gap-1">
                                <Baby className="w-4 h-4 text-purple-600" />
                                <span className="text-[8px] font-black text-purple-700 uppercase">Embarazo</span>
                            </div>
                        )}
                        {patient.medical_history?.cancer_history && (
                            <div className="p-3 bg-amber-50 border border-amber-100 rounded-2xl flex flex-col items-center text-center gap-1">
                                <AlertCircle className="w-4 h-4 text-amber-600" />
                                <span className="text-[8px] font-black text-amber-700 uppercase">Cáncer</span>
                            </div>
                        )}
                    </div>
                ) : (
                    <div className="mb-6 p-4 bg-green-50 border border-green-100 rounded-2xl flex items-center gap-3">
                        <ShieldAlert className="w-4 h-4 text-green-600" />
                        <span className="text-[9px] font-black text-green-700 uppercase tracking-widest">Sin alertas críticas detectadas</span>
                    </div>
                )}

                {/* Listados de Antecedentes */}
                <div className="space-y-4">
                    {patient.medical_history?.pathologies?.length > 0 && (
                        <div>
                            <p className="text-[8px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Patologías</p>
                            <div className="flex flex-wrap gap-1">
                                {patient.medical_history.pathologies.map((p, i) => (
                                    <span key={i} className="px-2 py-0.5 bg-slate-100 text-slate-600 text-[9px] font-bold rounded-md uppercase">{p}</span>
                                ))}
                            </div>
                        </div>
                    )}
                    {patient.medical_history?.medications?.length > 0 && (
                        <div>
                            <p className="text-[8px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Medicamentos</p>
                            <div className="flex flex-wrap gap-1">
                                {patient.medical_history.medications.map((m, i) => (
                                    <span key={i} className="px-2 py-0.5 bg-blue-50 text-blue-600 text-[9px] font-bold rounded-md uppercase">{m}</span>
                                ))}
                            </div>
                        </div>
                    )}
                    {patient.medical_history?.fractures?.length > 0 && (
                        <div>
                            <p className="text-[8px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Fracturas / Lesiones</p>
                            <div className="flex flex-wrap gap-1">
                                {patient.medical_history.fractures.map((f, i) => (
                                    <span key={i} className="px-2 py-0.5 bg-orange-50 text-orange-600 text-[9px] font-bold rounded-md uppercase">{f}</span>
                                ))}
                            </div>
                        </div>
                    )}
                    {patient.medical_history?.family_history?.length > 0 && (
                        <div>
                            <p className="text-[8px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Antecedentes Familiares</p>
                            <div className="flex flex-wrap gap-1">
                                {patient.medical_history.family_history.map((fh, i) => (
                                    <span key={i} className="px-2 py-0.5 bg-brand-primary/5 text-brand-primary text-[9px] font-bold rounded-md uppercase">{fh}</span>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            </div>

            {/* Tratamientos activos */}
            <div className="p-6 bg-white rounded-[2rem] border border-slate-100 shadow-sm">
              <h2 className="mb-6 text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
