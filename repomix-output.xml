                                            const valStr = String(e.target.value).replace(/[^0-9]/g, "");
                                            const priceLimit = String(selectedRate?.base_price_clp || 0).replace(/[^0-9]/g, "").length;
                                            if (valStr.length <= priceLimit) setData('amount_clp_own', e.target.value);
