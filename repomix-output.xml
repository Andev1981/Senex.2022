    {
        $currentCompanyId = session('current_company_id');
        
        $suppliers = Supplier::where('company_id', $currentCompanyId)
            ->orderBy('business_name', 'asc')
            ->get();

        return Inertia::render('acquisitions/Suppliers/Index', [
            'suppliers' => $suppliers
        ]);
    }

